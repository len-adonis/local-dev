# Prefer Vim
export VISUAL=vim
export EDITOR="$VISUAL"

# PATH
export PATH="$HOME/.local/bin:$PATH"
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

# Homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"

# Mise (so bd/beads and other tools work in bash too)
if [ -n "$ZSH_VERSION" ]; then
  eval "$(mise activate zsh)"
  eval "$($HOME/.local/bin/mise activate zsh)"
else
  eval "$(mise activate bash)"
  eval "$($HOME/.local/bin/mise activate bash)"
fi

# Worktrees from brtkwr.com/posts/2025-12-17-git-worktree-fzf-helper
wt() {
  local create=false
  local delete=false
  local copy_envrc=false
  local branch_name=""
  local target=""

  _wt_usage() {
    cat <<USAGE
Usage: wt [-c <branch_name>] [-e] [-d [path]] [-h]

Options:
  -c <branch_name>   Create a new worktree with branch name <branch_name>
  -e          Copy .envrc from root and run direnv allow (use with -c)
  -d [path]   Delete a worktree (fuzzy select if no path given, use '.' for current)
  -h          Show this help message
USAGE
  }

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -c) create=true; branch_name="$2"; shift 2 ;;
      -e) copy_envrc=true; shift ;;
      -d) delete=true; shift; [[ $# -gt 0 && ! "$1" =~ ^- ]] && { target="$1"; shift; } ;;
      -h) _wt_usage; return 0 ;;
      *) _wt_usage; return 1 ;;
    esac
  done

  if ($create || $copy_envrc) && $delete; then
    echo "Error: -c/-e and -d are mutually exclusive"; return 1
  fi

  if $create; then
    [[ -z "$branch_name" ]] && { echo "Error: -c requires a branch_name"; return 1; }
    local root=$(git rev-parse --show-toplevel)
    local parent_dir
    parent_dir="$(dirname "$root")"
    local repo_name
    repo_name="$(basename "$root")"
    local new_path="$parent_dir/worktrees/$repo_name-$branch_name"
    
    if git show-ref --verify --quiet "refs/heads/$branch_name"; then
        git worktree add "$new_path" "$branch_name" || return 1
    elif git show-ref --verify --quiet "refs/remotes/$remote_branch"; then
        git worktree add --track -b "$branch_name" "$new_path" "$remote_branch" || return 1
    else
        git worktree add "$new_path" -b "$branch_name" || return 1
    fi

    mise trust "$new_path" --all || return 1
    cd "$new_path" || return 1
    if $copy_envrc; then
      local files=(
          "$root/adonis-core/local.env"
          "$root/adonis-frontend/.env.local"
      )

      local source_file relative_path destination

      for source_file in "${files[@]}"; do
          if [[ -f "$source_file" ]]; then
              relative_path="${source_file#"$root"/}"
              destination="$new_path/$relative_path"

              mkdir -p "$(dirname "$destination")"
              cp "$source_file" "$destination"
          fi
      done
  fi

  elif $delete; then
    local to_delete
    if [[ -n "$target" ]]; then
      to_delete=$(realpath "$target")
    else
      to_delete=$(git worktree list | fzf --height 40% --reverse | awk '{print $1}')
    fi
    [[ -z "$to_delete" ]] && return 0
    local main_wt=$(git worktree list | head -1 | awk '{print $1}')
    if [[ "$to_delete" == "$main_wt" ]]; then
      echo "Error: cannot delete main worktree"; return 1
    fi
    local branch
    branch="$(git -C "$to_delete" branch --show-current)"
    [[ "$(realpath .)" == "$to_delete"* ]] && cd "$main_wt"
    git worktree remove "$to_delete"
    if [[ -n "$branch" ]]; then
      local reply
      read -r "reply?Force delete local branch '$branch' too? [y/N] "

      if [[ "$reply" == [yY] ]]; then
        git branch -D "$branch" 
      fi
    fi

  else
    local selected=$(git worktree list | fzf --height 40% --reverse | awk '{print $1}')
    [[ -n "$selected" ]] && cd "$selected"
  fi
}

